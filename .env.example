# Database Configuration
POSTGRES_DB=transcendence
POSTGRES_USER=transcendence_user
POSTGRES_PASSWORD=your-secure-password
SPRING_DATASOURCE_PASSWORD=your-secure-password

# Spring Boot Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/transcendence
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# JWT Configuration
# IMPORTANT: Change this to a long random string in production
JWT_SECRET=your-super-secret-key-that-is-at-least-32-characters-long-change-in-prod

# Mail Configuration
MAIL_PASSWORD=your-mail-app-password
# Inbox that receives messages sent through the /contact support form
SUPPORT_EMAIL=your-support-inbox@example.com

# OAuth2 Configuration
OAUTH2_42_CLIENT_ID=your-42-client-id
OAUTH2_42_CLIENT_SECRET=your-42-client-secret

# Frontend Configuration
API_URL=http://localhost:8080
NODE_ENV=development
# Must match the nginx HTTPS port (default 8443)
APP_FRONTEND_URL=https://localhost:8443

# CORS Configuration (Backend)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Port Configuration
FRONTEND_PORT=4200
BACKEND_PORT=8080
DATABASE_PORT=5432

# Timezone (aligns backend LocalDateTime with users' local clock)
TZ=Europe/Paris

# Blockchain / TK42 (BSC Testnet)
# Set to true to mint real TK42 on-chain when an admin credits a user.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BLOCKCHAIN_CHAIN_ID=97
BLOCKCHAIN_CONTRACT_ADDRESS=0x3aBfE55f0D8468edC60f363aECE6Ae136ADB99Dd
BLOCKCHAIN_TOKEN_DECIMALS=18
# Private key of the contract owner (hot wallet). NEVER commit a real key.
BLOCKCHAIN_PRIVATE_KEY=
